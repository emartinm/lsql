# systemd unit of the SQL judge (Django + gunicorn). Replace <user> and <base>
# (see deploy/manage.sh for the layout) and copy it to /etc/systemd/system/lsql.service.
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now lsql

[Unit]
Description=Learn SQL (Django + gunicorn)
# If PostgreSQL runs on this machine as a systemd service, add it with Requires= and After=.
# Oracle goes with Wants= and not Requires=: if it stops, the web keeps working and only the
# submissions fail (with Requires= the whole judge would stop with it and not come back).
Wants=lsql-oracle.service
After=network.target lsql-oracle.service

[Service]
User=<user>
Group=<user>
EnvironmentFile=<base>/env
WorkingDirectory=<base>/app/lsql
ExecStart=<base>/venv/bin/gunicorn -c <base>/app/deploy/gunicorn.conf.py lsql.wsgi
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
