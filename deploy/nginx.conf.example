# Locations of the SQL judge, to add inside the HTTPS server block of its domain.
# Replace <base> and <port> (GUNICORN_BIND), then: sudo nginx -t && sudo systemctl reload nginx
# Other applications of the same domain (e.g. haskell-judge under /haskell/) have their own
# locations, static files and cookies, so they do not interfere.

location = /sql { return 301 /sql/; }

# STATIC_URL of the judge (settings_shared.py)
location /static/ {
    alias <base>/app/lsql/allstaticfiles/;
}

location /sql/ {
    proxy_pass http://127.0.0.1:<port>;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;    # a submission may wait for a free Oracle connection
    client_max_body_size 10m;   # ZIPs of problems uploaded by teachers
}
