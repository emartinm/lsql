# Production configuration: copy to <base>/env (owner: the user of the judge, mode 600)
# and fill in the values. Format: systemd EnvironmentFile (no "export", no quotes).
ALLOWED_HOSTS=judge.example.org
GUNICORN_BIND=127.0.0.1:8000
SECRET_KEY=
# PostgreSQL (data of the judge)
PG_DB=lsql
PG_USER=lsql
PG_PASS=
PG_SERVER=localhost
PG_PORT=5432
# Oracle (where submissions are executed). The judge uses oracledb in "thick mode": the
# Oracle Instant Client libraries must be in the loader path (ldconfig or LD_LIBRARY_PATH).
# Values are read literally ($VAR is not expanded): write the whole list of directories.
LD_LIBRARY_PATH=/opt/oracle/instantclient:<base>/des/lib
# ORACLE_PASS and ORACLE_PORT are also used by deploy/oracle-xe.sh (Oracle XE in Docker)
ORACLE_SERVER=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XE
ORACLE_TABLESPACE=USERS
ORACLE_USER=SYSTEM
ORACLE_PASS=
ORACLE_MAX_GESTOR_CONNECTIONS=20
ORACLE_GESTOR_POOL_TIMEOUT_MS=20000
ORACLE_STMT_TIMEOUT_MS=1500
ORACLE_MAX_COLS=30
ORACLE_MAX_ROWS=1000
ORACLE_MAX_TABLES=30
# DES (Datalog Educational System), extra feedback on SELECT queries
DES_BIN=<base>/des/des_start
DES_TIMEOUT=5
SENTRY_DSN=
